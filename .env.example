# Copy to .env (git-ignored). Load into your run config or `export $(cat .env | xargs)`.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/outpost
SPRING_DATASOURCE_USERNAME=outpost
SPRING_DATASOURCE_PASSWORD=outpost

# Week 2 – OAuth2 (lead provides Google; LinkedIn is optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Week 2 – email (Mailpit from docker-compose)
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025

# Week 3 – object storage (MinIO from docker-compose)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=outpost
S3_SECRET_KEY=outpost123
S3_BUCKET=pitch-decks

# Week 3 – LLM (lead provides the key; never commit it)
LLM_API_KEY=
